#!/bin/bash

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || return 1
  return 0
}

require_cmds() {
  local cmd

  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || return 1
  done
  return 0
}


setup_init() {
  mkdir -p "${HOME}/.config"
  case "$(uname -s)" in
    Linux*)               OS_TYPE="linux";;
    Darwin*)              OS_TYPE="macos";;
    CYGWIN*|MINGW*|MSYS*) OS_TYPE="wsl";;
    *)                    OS_TYPE="unknown";;
  esac
}

setup_beyondcompare() {
  # TODO beyond compare
  # rename BCompare BCompare.exe
  # ln -sf $HOME/.dotfiles/bcompare/BCompare /Application/Beyond Compare.app/Content/MacOS

  # ASDF
  # mkdir -p "${ASDF_DATA_DIR:-$HOME/.asdf}/completions"
  # asdf completion zsh > "${ASDF_DATA_DIR:-$HOME/.asdf}/completions/_asdf"

  #echo "source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" >> $HOME/.zshrc
  #echo "source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" >> ~/.zshrc

  # Git 
  #git config --global core.editor "code --wait"
  true
}

setup_passwordless() {
  # Set passwordless sudo
  USER_NAME=$(whoami)
  echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" | \
  sudo tee /etc/sudoers.d/${USER_NAME}
  sudo chmod 444 /etc/sudoers.d/${USER_NAME}
  sudo visudo -cf /etc/sudoers.d/${USER_NAME}
}

setup_xcode_cli() {
  # Install XCode CLI (Mandatory)
  [[ -d "/Library/Developer/CommandLineTools" ]] && return 0
  sudo rm -rf /Library/Developer/CommandLineTools
  xcode-select --install
}

setup_brew_cli() {

  require_cmd "brew" || {
    # Install Brew CLI
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo >> ${HOME}/.zprofile
    grep -q '/opt/homebrew/bin/brew shellenv' "${HOME}/.zprofile" 2>/dev/null || \
      echo 'eval "$(/opt/homebrew/bin/brew shellenv zsh)"' >> "${HOME}/.zprofile"
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
  }
}


setup_screenlock() {
  sudo pmset -a sleep 0
  sudo pmset -a displaysleep 0
}

setup_ohmyzsh() {
  [[ -d "${HOME}/.oh-my-zsh" ]] || \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/robbyrussell/oh-my-zsh/master/tools/install.sh)"

  [[ -d "${HOME}/.oh-my-zsh/custom/plugins/zsh-autosuggestions" ]] || \
    git clone https://github.com/zsh-users/zsh-autosuggestions.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

  [[ -d "${HOME}/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting" ]] || \
    git clone https://github.com/zsh-users/zsh-syntax-highlighting ${ZSH_CUSTOM:=~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting

  [[ -d "${HOME}/.oh-my-zsh/custom/plugins/zsh-completions" ]] || \
    git clone https://github.com/zsh-users/zsh-completions ${ZSH_CUSTOM:=~/.oh-my-zsh/custom}/plugins/zsh-completions

  if ! cmp -s ${HOME}/.zshrc ${HOME}/.dotfiles/zsh/.zshrc; then
    mkdir -p "${HOME}/.backup/zshrc"
    [[ "${HOME}/.zshrc" ]] && cp ${HOME}/.zshrc "${HOME}/.backup/zshrc/zshrc.$(date +%Y%m%d-%H%M%S)"
    ln -sf ${HOME}/.dotfiles/zsh/.zshrc ${HOME}/.zshrc
  fi
}

setup_brew_install() {
  export HOMEBREW_BUNDLE_FILE=${HOMEBREW_BUNDLE_FILE:-${HOME}/.dotfiles/Brewfile}
  brew trust hashicorp/tap
  brew bundle
  ln -sf ${HOME}/.dotfiles/ghostty ${HOME}/.config
  ln -sf ${HOME}/.dotfiles/starship ${HOME}/.config
  ln -sf ${HOME}/.dotfiles/harlequin ${HOME}/.config
  ln -sf ${HOME}/.dotfiles/hedr ${HOME}/.config
}

setup_gitconfig() {
  case "$(uname -s)" in
    Darwin)
      git config --global credential.helper osxkeychain
      git config --global user.email jlim@interos.ai
      echo "Configured Git to use macOS Keychain"
      ;;
    *)
      git config --global credential.helper store
      git config --global user.email josephlim@as3tech.com
      echo "Configured Git to use credential store"
      ;;
  esac
  git config --global user.name "Joseph Lim"
}

setup_macos_wallpaper() {
  case "${OS_TYPE}" in
    macos)
      if [[ -n "${DESKTOP_WALPAPER_PATH}" ]]; then
        automator -i "${DESKTOP_WALPAPER_PATH}" $HOME/Desktop/setDesktopPix.workflow
      fi
      # Set macOS wallpaper here
      ;;
    *);;
  esac
}

main() {
  setup_init
  setup_passwordless
  setup_xcode_cli
  setup_brew_cli
  setup_screenlock
  setup_ohmyzsh
  setup_gitconfig
  setup_brew_install
  setup_macos_wallpaper
}

main "$@"

